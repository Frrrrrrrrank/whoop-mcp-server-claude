# Required: WHOOP developer credentials (https://developer.whoop.com/)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Required: public origin of this server (no trailing slash).
# Used to build redirect_uri = ${PUBLIC_URL}/callback
# - Local dev: http://localhost:3000
# - Render:    https://your-service.onrender.com
PUBLIC_URL=http://localhost:3000

# Optional: HTTP port (Render sets PORT automatically).
PORT=3000

# Optional: pre-seed the in-memory token store with a WHOOP refresh token
# so the server survives cold starts on platforms without persistent storage.
# Copy from /callback success page after first OAuth round-trip.
WHOOP_REFRESH_TOKEN=
